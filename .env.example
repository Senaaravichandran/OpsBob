# OpsBob Environment Configuration
# Copy this file to .env and fill in your actual values

# ============================================================================
# IBM Bob API Configuration
# ============================================================================
# Bob API key for AI-powered incident analysis
# Get your key from: https://cloud.ibm.com/bob
BOB_API_KEY=bob_prod_bob-user_43V91SpnLr19WwxFsTKjrrk3iD6K6wApsnKf6jVt7YjrJfSRc5WMGMqb3E28CrPYZkUGicxy68C17u5QDQC8Z2F3_CooJ5ywytUWrPMmpTn14yEiBdp8kYKZk1yniikGG9vs7

# Bob API endpoint URL
BOB_API_URL=https://api.bob.ibm.com

# ============================================================================
# Instana Monitoring Configuration
# ============================================================================
# Instana tenant base URL (e.g., https://acme-prod.instana.io)
# Used by MCP server to fetch real incident data
INSTANA_BASE_URL=https://your-tenant.instana.io

# Instana API token for authentication
# Generate from: Instana UI → Settings → API Tokens
INSTANA_API_TOKEN=your_instana_api_token_here

# ============================================================================
# IBM Cloud Configuration
# ============================================================================
# IBM Cloud API key for Container Registry and Code Engine access
# Create from: https://cloud.ibm.com/iam/apikeys
IBM_CLOUD_API_KEY=adfdandflandalkdnalkdnawl

# IBM Cloud region where resources are deployed
# Options: us-south, us-east, eu-gb, eu-de, jp-tok, au-syd
IBM_CLOUD_REGION=us-south

# Code Engine project name
CODE_ENGINE_PROJECT=opsbob-demo

# ============================================================================
# IBM Container Registry Configuration
# ============================================================================
# Container Registry namespace for Docker images
# Must be created in advance: ibmcloud cr namespace-add <namespace>
ICR_NAMESPACE=opsbob

# ============================================================================
# Code Engine Application Configuration
# ============================================================================
# Name of the Code Engine application to deploy fixes to
CODE_ENGINE_APP_NAME=payments-api

# ============================================================================
# Source Files Configuration
# ============================================================================
# Path to the microservice source files on disk (relative to project root)
# This directory should contain the files Bob will analyze and fix
SOURCE_FILES_PATH=demo-service

# ============================================================================
# Server Configuration
# ============================================================================
# FastAPI backend server port
BACKEND_PORT=8000

# MCP server port (if using HTTP instead of stdio)
# MCP_SERVER_PORT=3001

# Frontend development server port
FRONTEND_PORT=3000

# ============================================================================
# Optional: Development Configuration
# ============================================================================
# Node environment (development, production)
# NODE_ENV=development

# Enable debug logging
# DEBUG=true

# Log level (debug, info, warning, error)
# LOG_LEVEL=info